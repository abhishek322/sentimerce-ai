# Copy these into `.env.local` at the project root.

# Preferred (server-only — not exposed to the browser)
GEMINI_API_KEY=your_google_gemini_api_key

# Legacy / already supported in this project
NEXT_PUBLIC_GEMINI_API_KEY=your_google_gemini_api_key

# Optional override (defaults to gemini-3.8-flash, then gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash
